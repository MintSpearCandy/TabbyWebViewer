h3 Web Viewer

.form-line
    .header
        .title Default scheme for bare hosts
        .description Scheme prepended when a URL without one is entered (localhost and IP hosts always use http)
    select.form-control(
        style='max-width: 120px',
        [(ngModel)]='defaultScheme',
        (ngModelChange)='save()')
        option(value='https') https://
        option(value='http') http://

.form-line
    .header
        .title Session recorder layout
        .description
            | Where the recorder panel appears. Bottom ↔ right switch live for an
            | open panel; the detached tab applies the next time you start recording.
            | Re-click the record button to bring a hidden panel back.
    select.form-control(
        style='max-width: 260px',
        [(ngModel)]='recorderLayout',
        (ngModelChange)='save()')
        option(value='right') Right drawer (in pane, default)
        option(value='bottom') Bottom drawer (in pane)
        option(value='tab') Detached tab (split-friendly)

.form-line
    .header
        .title Browsing data
        .description
            | Each pane keeps its own isolated, persistent cookie jar on disk.
            | {{partitionCount}} partition{{partitionCount === 1 ? '' : 's'}} currently exist (including panes from previous sessions).
    div
        button.btn.btn-danger(
            (click)='clearAll()',
            [disabled]='clearing || partitionCount === 0')
            | {{clearing ? 'Clearing…' : 'Clear all browsing data'}}
        span.text-muted(*ngIf='clearedMessage', style='margin-left: 8px') {{clearedMessage}}
