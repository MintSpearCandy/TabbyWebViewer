.webviewer-root
    .webviewer-toolbar((click)='onToolbarClick($event)')
        button.btn.btn-sm.btn-link((click)='reload()', title='Reload (F5)', *ngIf='!loading')
            i.fas.fa-rotate-right
        button.btn.btn-sm.btn-link((click)='stopLoading()', title='Stop', *ngIf='loading')
            i.fas.fa-xmark
        button.btn.btn-sm.btn-link((click)='goBack()', [disabled]='!canGoBack', title='Back (Alt+Left)')
            i.fas.fa-arrow-left
        button.btn.btn-sm.btn-link((click)='goForward()', [disabled]='!canGoForward', title='Forward (Alt+Right)')
            i.fas.fa-arrow-right
        input.form-control.form-control-sm.webviewer-address(
            #addressBarInput,
            type='text',
            [(ngModel)]='addressBar',
            (keydown.enter)='!$event.isComposing && onAddressEnter()',
            (keyup.escape)='!$event.isComposing && onAddressEscape()',
            placeholder='Enter a URL…',
            spellcheck='false')
        button.btn.btn-sm.btn-link((click)='toggleDevTools()', title='Developer tools (F12)')
            i.fas.fa-code
        button.btn.btn-sm.btn-link((click)='clearBrowsingData()',
            title="Clear this pane's browsing data (cookies, storage, cache)")
            i.fas.fa-eraser
        button.btn.btn-sm.btn-link((click)='openInSystemBrowser()', title='Open in system browser')
            i.fas.fa-arrow-up-right-from-square
    .webviewer-content(#content)
        .webviewer-empty(*ngIf='!hasUrl && !loadError')
            i.fas.fa-globe
            p Enter a URL in the address bar above
        .webviewer-error(*ngIf='loadError')
            h5 {{loadError.description || 'Failed to load page'}}
            p.text-muted {{loadError.url}} — error {{loadError.code}}
            .webviewer-error-actions
                button.btn.btn-primary((click)='reload()') Reload
                button.btn.btn-secondary((click)='openInSystemBrowser()') Open in system browser
